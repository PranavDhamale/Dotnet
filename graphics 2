#include <GL/glut.h>
#include <iostream>
#include <cmath>
using namespace std;
const int WIDTH = 800;
const int HEIGHT = 600;
int xc = 400,
    yc = 300,
    radius = 100;
int algorithm = 1, style = 1;
// Function to check whether a point should be displayed
bool showPoint(int i)
{
    if (style == 1)
        // Solid
        return true;
    else if (style == 2)
        // Dotted
        return (i % 6 == 0);
    else
        // Dashed
        return (i % 20 < 12);
}
// Plot a pixel
void plotPixel(int x, int y)
{
    glVertex2i(x, y);
}
// Draw circle using DDA algorithm
void DDACircle()
{
    float x, y, theta;
    float step = 1.0f / radius;
    int i = 0;
    glBegin(GL_POINTS);
    for (theta = 0; theta < 2 * M_PI; theta += step)
    {
        x = radius * cos(theta);
        y = radius * sin(theta);
        if (showPoint(i))
        {
            plotPixel(xc + round(x), yc + round(y));
        }
        i++;
    }
    glEnd();
} // Plot eight symmetric points of a circle
void plotEightPoints(int x, int y, int i)
{
    if (!showPoint(i))
        return;
    plotPixel(xc + x, yc + y);
    plotPixel(xc - x, yc + y);
    plotPixel(xc + x, yc - y);
    plotPixel(xc - x, yc - y);
    plotPixel(xc + y, yc + x);
    plotPixel(xc - y, yc + x);
    plotPixel(xc + y, yc - x);
    plotPixel(xc - y, yc - x);
} // Draw circle using Bresenham's algorithm
void BresenhamCircle()
{
    int x = 0;
    int y = radius;
    int d = 3 - 2 * radius;
    int i = 0;
    glBegin(GL_POINTS);
    while (x <= y)
    {
        plotEightPoints(x, y, i);
        if (d < 0)
        {
            d = d + 4 * x + 6;
        }
        else
        {
            d = d + 4 * (x - y) + 10;
            y--;
        }
        x++;
        i++;
    }
    glEnd();
} // Draw circle using Midpoint algorithm
void MidpointCircle()
{
    int x = 0;
    int y = radius;
    int p = 1 - radius;
    int i = 0;
    glBegin(GL_POINTS);
    while (x <= y)
    {
        plotEightPoints(x, y, i);
        x++;
        if (p < 0)
        {
            p = p + 2 * x + 1;
        }
        else
        {
            y--;
            p = p + 2 * (x - y) + 1;
        }
        i++;
    }
    glEnd();
} // Display callback
void display()
{
    glClear(GL_COLOR_BUFFER_BIT);
    glColor3f(0.0, 0.0, 0.0);
    glPointSize(2.0);
    if (algorithm == 1)
        DDACircle();
    else if (algorithm == 2)
        BresenhamCircle();
    else if (algorithm == 3)
        MidpointCircle();
    glFlush();
} // Initialize OpenGL
void init()
{
    glClearColor(1.0, 1.0, 1.0, 1.0);
    glMatrixMode(GL_PROJECTION);
    glLoadIdentity();
    gluOrtho2D(0, WIDTH, 0, HEIGHT);
    glMatrixMode(GL_MODELVIEW);
    glLoadIdentity();
} // Main function
int main(int argc, char **argv)
{
    cout << "====================================\n";
    cout << "      CIRCLE DRAWING PROGRAM\n";
    cout << "====================================\n";
    cout << "\nSelect Circle Drawing Algorithm:\n";
    cout << "1. DDA Circle Algorithm\n";
    cout << "2. Bresenham's Circle Algorithm\n";
    cout << "3. Midpoint Circle Algorithm\n";
    cout << "Enter your choice: ";
    cin >> algorithm;
    if (algorithm < 1 || algorithm > 3)
    {
        cout << "Invalid algorithm choice!\n";
        return 0;
    }
    cout << "\nSelect Circle Style:\n";
    cout << "1. Solid Circle\n";
    cout << "2. Dotted Circle\n";
    cout << "3. Dashed Circle\n";
    cout << "Enter your choice: ";
    cin >> style;
    if (style < 1 || style > 3)
    {
        cout << "Invalid style choice!\n";
        return 0;
    }
    cout << "\nEnter center coordinates (xc yc): ";
    cin >> xc >> yc;
    cout << "Enter radius: ";
    cin >> radius;
    if (radius <= 0 || xc - radius < 0 || xc + radius > WIDTH || yc - radius < 0 || yc + radius > HEIGHT)
    {
        cout << "Invalid radius or center coordinates!\n";
        cout << "The circle must fit inside the 800 x 600 window.\n";
        return 0;
    }
    glutInit(&argc, argv);
    glutInitDisplayMode(GLUT_SINGLE | GLUT_RGB);
    glutInitWindowSize(WIDTH, HEIGHT);
    glutInitWindowPosition(100, 100);
    glutCreateWindow("Circle Drawing Algorithms - OpenGL");
    init();
    glutDisplayFunc(display);
    glutMainLoop();
    return 0;
}